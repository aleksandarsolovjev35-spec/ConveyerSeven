# Скопируй в .env и поправь под своё рабочее место
# Для быстрой проверки без железа оставь SIMULATION_MODE=true

# === Режим ===
# true  — симуляция (мок-камеры, мок-конвейер, мок-модели, не нужны веса и COM)
# false — боевая линия (нужны 7 камер, COM-порт, weights/*.pt)
SIMULATION_MODE=true
# SIMULATION_VIDEO_FILE=sample.mp4  # опционально: видео вместо чёрных кадров в симуляции

# === Железо (только для SIMULATION_MODE=false) ===
# SERIAL_PORT=COM4          # Windows пример
# SERIAL_PORT=/dev/ttyUSB0  # Linux пример
# SERIAL_BAUD=115200
# CAMERA_BACKENDS=dshow,msmf  # Windows; на Linux оставь пустым (V4L2)

# === База и логи ===
# DATABASE_FILE=conveyer.db
# LOG_DIR=logs
# LOG_LEVEL=INFO

# === Безопасность ===
# ADMIN_PIN должен быть >=8 символов; в Docker обязательно задай
ADMIN_PIN=CHANGE_ME_123

# === Docker ===
# UI_PORT=8000
# SERIAL_DEVICE=/dev/ttyUSB0
# CAMERA_0=/dev/video0
# ...
